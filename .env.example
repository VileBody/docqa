# No credentials included. Set API key, model endpoints and a newly authorized ledger yourself.
# TEST_MODE=1 uses labeled deterministic doubles; MODEL_CALLS_ENABLED stays 0 for CPU checks.
DOCQA_API_KEY=
DOCQA_TEST_MODE=0
DOCQA_MODEL_CALLS_ENABLED=0
DOCQA_ALLOW_PDF=0
DOCQA_HTTP_PORT=18080
DOCQA_NAMESPACE=docqa2
DOCQA_PROFILE=/app/profiles/submission/sol_p1_runtime.json
DOCQA_BUDGET_LEDGER=/data/authorized-budget.json
DOCQA_RERANK_INPUT_LIMIT=24
DOCQA_RERANK_OUTPUT_LIMIT=6
DOCQA_PACK_CHARS=8000
DOCQA_CHUNK_SIZE=1200
DOCQA_CHUNK_OVERLAP=160
DOCQA_FUSION=rrf
DOCQA_RERANK_MODEL=
DOCQA_RERANK_REVISION=
DOCQA_RERANK_INSTRUCTION=
DOCQA_EMBED_BASE_URL=
DOCQA_EMBED_API_KEY=
DOCQA_RERANK_BASE_URL=
DOCQA_RERANK_API_KEY=
DOCQA_QWEN_BASE_URL=
DOCQA_QWEN_API_KEY=
DOCQA_OPENAI_BASE_URL=
DOCQA_OPENAI_API_KEY=
DOCQA_EMBED_MODEL=
DOCQA_EMBED_REVISION=
DOCQA_EMBED_TOKENIZER_PATH=
DOCQA_EMBED_INPUT_TOKENS=
DOCQA_EMBED_CONTEXT_TOKENS=
DOCQA_EMBED_OUTPUT_TOKENS=
DOCQA_QWEN_MODEL=
DOCQA_QWEN_REVISION=
DOCQA_QWEN_TOKENIZER_PATH=
DOCQA_QWEN_INPUT_TOKENS=
DOCQA_QWEN_CONTEXT_TOKENS=
DOCQA_QWEN_OUTPUT_TOKENS=
DOCQA_OPENAI_MODEL=
DOCQA_OPENAI_REVISION=
DOCQA_OPENAI_TOKENIZER_PATH=
DOCQA_OPENAI_INPUT_TOKENS=
DOCQA_OPENAI_CONTEXT_TOKENS=
DOCQA_OPENAI_OUTPUT_TOKENS=
DOCQA_EMBED_DIMENSION=

# Product API uses P1 + six demonstrations + strict renderer. Historical library defaults unchanged.
DOCQA_READER_PROFILE=/app/profiles/submission/sol_p1_v2.json
